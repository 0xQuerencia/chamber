{
  "name": "chamber",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "npm run typecheck && node --check src/worker.js && node --test tests/*.test.js",
    "dev:worker": "wrangler dev",
    "dev:preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.50.0"
  }
}
