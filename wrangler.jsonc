{
  "name": "chamber",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["0 1 1 * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "chamber-db",
    "database_id": "ecb99289-8a95-4f8b-a660-f295da9baca5",
    "migrations_dir": "migrations"
  }]
}
